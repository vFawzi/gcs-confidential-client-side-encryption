#!/bin/bash
# ==============================================================================
# v2/stage2/stage2_config.env.example - Sanitized Configuration Template for Stage 2 OS-Level Agent CSE
#
# INSTRUCTIONS:
# 1. Copy this template to 'stage2_config.env':
#      cp stage2_config.env.example stage2_config.env
# 2. Export your target Google Cloud Project ID (or populate below) and
#    deployer identity BEFORE executing ./deploy_cse_vm.sh:
#      export PROJECT_ID="your-project-id"
# ==============================================================================

# 1. Core GCP Project, Location & Deployer Settings (EU Data Residency Default)
export PROJECT_ID="${PROJECT_ID:-your-project-id}"
export REGION="europe-west4"
export ZONE="europe-west4-a"
export DEPLOYER_PRINCIPAL="user:user@example.com"

# 2. VPC Networking & Cloud NAT Settings
export VPC_NETWORK="test"
export VPC_SUBNET="nl"
export VPC_SUBNET_CIDR="10.0.0.0/24"
export CLOUD_ROUTER_NAME="${VPC_NETWORK}-nat-router"
export CLOUD_NAT_NAME="${VPC_NETWORK}-nat-gateway"

# 3. Cryptographic Settings (Cloud KMS)
export KMS_KEY_RING="cse-keyring-mvp"
export KMS_CRYPTO_KEY="cse-proxy-key"
export KMS_KEY_URI="gcp-kms://projects/${PROJECT_ID}/locations/${REGION}/keyRings/${KMS_KEY_RING}/cryptoKeys/${KMS_CRYPTO_KEY}"

# 4. Stage 2: OS-Level Agent (Confidential VM + gcsfuse + gocryptfs) Settings
export VM_NAME="cse-confidential-vm"
export VM_SA_NAME="cse-vm-sa"
export VM_SA_EMAIL="${VM_SA_NAME}@${PROJECT_ID}.iam.gserviceaccount.com"
export STAGE2_BUCKET_NAME="cse-os-agent-bucket-${PROJECT_ID}"
export GCS_RAW_MOUNT="/mnt/gcs_raw"
export GCS_SECURE_MOUNT="/mnt/gcs_secure"
export IAP_FIREWALL_RULE="allow-iap-ssh-cse-vm"
export IAP_NETWORK_TAG="cse-iap-ssh"

# 5. GitHub Actions CI/CD Workload Identity Federation (WIF) Settings
export GITHUB_REPO="${GITHUB_REPO:-username/gcs-confidential-client-side-encryption}"
export CI_SA_NAME="cse-github-ci-sa"
export CI_SA_EMAIL="${CI_SA_NAME}@${PROJECT_ID}.iam.gserviceaccount.com"
export WIF_POOL_NAME="github-actions-pool"
export WIF_PROVIDER_NAME="github-oidc-provider"


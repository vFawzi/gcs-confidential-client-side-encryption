#!/bin/bash
# ==============================================================================
# v2/cse_config.env.example - Sanitized Configuration Template for Stage 1 (Confidential GKE CSE)
#
# INSTRUCTIONS:
# 1. Copy this template to 'cse_config.env':
#      cp cse_config.env.example cse_config.env
# 2. Populate the variables below with your target Google Cloud Project ID and
#    deployer identity BEFORE executing ./deploy_cse_gke.sh.
# ==============================================================================

# 1. Core GCP Project, Location & Deployer Settings (EU Data Residency Default)
export PROJECT_ID="${PROJECT_ID:-your-project-id}"
export REGION="europe-west4"
export ZONE="europe-west4-a"
export DEPLOYER_PRINCIPAL="user:user@example.com"

# 2. VPC Networking, Private Cluster & Cloud NAT Settings
export VPC_NETWORK="test"
export VPC_SUBNET="nl"
export VPC_SUBNET_CIDR="10.0.0.0/24"
export MASTER_IPV4_CIDR="172.16.0.0/28"
export CLOUD_ROUTER_NAME="${VPC_NETWORK}-nat-router"
export CLOUD_NAT_NAME="${VPC_NETWORK}-nat-gateway"

# 3. Zero-Trust Identity Separation (3 Dedicated Service Accounts - No Default Compute SA)
export SA_NAME="cse-proxy-sa"               # Workload Identity Pod SA (KMS + Data Bucket)
export GKE_NODE_SA_NAME="cse-gke-node-sa"   # Least-Privilege GKE Node Pool SA (Logs/Metrics + AR Reader)
export CLOUDBUILD_SA_NAME="cse-build-sa"    # Least-Privilege Cloud Build SA (Staging Bucket + AR Writer)

# 4. Cryptographic Settings (Cloud KMS)
export KMS_KEY_RING="cse-keyring-mvp"
export KMS_CRYPTO_KEY="cse-proxy-key"

# 5. Data & Build Staging Storage Settings (Cloud Storage - Regional EU)
export BUCKET_NAME="cse-prod-bucket-${PROJECT_ID}-2993"
export BUILD_STAGING_BUCKET="${PROJECT_ID}-cse-build-staging"

# 6. Container & Kubernetes Cluster Settings
export CLUSTER_NAME="cse-confidential-cluster"
export AR_REPO="cse-repo"

# 7. Derived Identities, URIs & Kubernetes Workload Settings
export K8S_NAMESPACE="default"
export K8S_SA="cse-k8s-sa"
export DEPLOYMENT_NAME="secure-app-deployment"
export MAIN_APP_IMAGE="nginx:alpine"

export SA_EMAIL="${SA_NAME}@${PROJECT_ID}.iam.gserviceaccount.com"
export GKE_NODE_SA_EMAIL="${GKE_NODE_SA_NAME}@${PROJECT_ID}.iam.gserviceaccount.com"
export CLOUDBUILD_SA_EMAIL="${CLOUDBUILD_SA_NAME}@${PROJECT_ID}.iam.gserviceaccount.com"

export KMS_KEY_URI="gcp-kms://projects/${PROJECT_ID}/locations/${REGION}/keyRings/${KMS_KEY_RING}/cryptoKeys/${KMS_CRYPTO_KEY}"
export IMAGE_NAME="${REGION}-docker.pkg.dev/${PROJECT_ID}/${AR_REPO}/cse-sidecar:latest"
